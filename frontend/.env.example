# ---------------------------------------------------------------------------
# Network
#   mainnet  Arc (chain 5042)
#   fork     local anvil fork of Arc mainnet (npm run fork in the repo root writes .env.development.local for you)
#   testnet  Arc testnet (5042002); the Uniswap pools this app trades on exist on mainnet only
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NETWORK=mainnet
# Leave empty for the defaults (mainnet: https://rpc.mainnet.arc.io, explorer https://explorer.arc.io).
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
# Optional: enables WalletConnect (mobile wallets). Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Protocol deployment (printed by script/Deploy.s.sol)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSITION_MANAGER=
NEXT_PUBLIC_LP_VAULT=
NEXT_PUBLIC_ORACLE=
NEXT_PUBLIC_INSURANCE=

# Optional overrides. Defaults: Uniswap V4Quoter 0x8Dc1…8F94, WETH 0x128c…4EDB, cirBTC 0x171A…bAA0 (Arc mainnet).
NEXT_PUBLIC_V4_QUOTER=
NEXT_PUBLIC_WETH=
NEXT_PUBLIC_CIRBTC=

# ---------------------------------------------------------------------------
# Waitlist (server-side only)
# ---------------------------------------------------------------------------
# Any Postgres URL (Neon, Supabase, Vercel Postgres...). Without it, signups go to .data/waitlist.json
# which is fine for local development only.
DATABASE_URL=
# Bearer token for GET /api/waitlist/export (CSV download).
WAITLIST_ADMIN_TOKEN=
