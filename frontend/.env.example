# ---------------------------------------------------------------------------
# Network: "mainnet" (Arc, chain 5042) or "testnet" (Arc testnet, chain 5042002)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NETWORK=mainnet
# Leave empty to use the default public RPC / explorer for the selected network.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
# Optional: enables WalletConnect (mobile wallets). Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Protocol deployment (printed by script/Deploy.s.sol)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSITION_MANAGER=
NEXT_PUBLIC_LP_VAULT=
NEXT_PUBLIC_ORACLE=
NEXT_PUBLIC_INSURANCE=

# ---------------------------------------------------------------------------
# Uniswap v3 on Arc. The router must be whitelisted with PositionManager.setRouter.
# SWAP_ROUTER_KIND: "router02" (SwapRouter02, no deadline field) or "router" (original SwapRouter).
# QUOTER is QuoterV2; optional but strongly recommended (used to size minAmountOut).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SWAP_ROUTER=
NEXT_PUBLIC_SWAP_ROUTER_KIND=router02
NEXT_PUBLIC_QUOTER=

# Tradable assets as JSON. pythId is the Pyth price feed id, fee is the Uniswap v3 pool fee tier,
# chartSymbol is the Pyth Benchmarks symbol used for candles.
NEXT_PUBLIC_ASSETS=[{"symbol":"BTC","name":"Bitcoin","address":"0x0000000000000000000000000000000000000000","decimals":8,"pythId":"0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43","fee":3000,"chartSymbol":"Crypto.BTC/USD"},{"symbol":"ETH","name":"Ethereum","address":"0x0000000000000000000000000000000000000000","decimals":18,"pythId":"0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace","fee":3000,"chartSymbol":"Crypto.ETH/USD"}]

# ---------------------------------------------------------------------------
# Pyth (server-side). Hermes requires an API key since the 2026 Pyth Core upgrade (get one from Pyth).
# The browser talks to /api/pyth, which adds the key, so it never reaches the client.
# ---------------------------------------------------------------------------
PYTH_API_KEY=
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_BENCHMARKS_URL=https://benchmarks.pyth.network
# Optional: point the browser at a Hermes you run yourself instead of the built-in proxy.
NEXT_PUBLIC_HERMES_URL=

# ---------------------------------------------------------------------------
# Waitlist (server-side only)
# ---------------------------------------------------------------------------
# Any Postgres URL (Neon, Supabase, Vercel Postgres, RDS...). Without it, signups go to .data/waitlist.json
# which is fine for local development only.
DATABASE_URL=
# Bearer token for GET /api/waitlist/export (CSV download).
WAITLIST_ADMIN_TOKEN=
