# Copy to .env.local. Everything targets Base mainnet (chain 8453).

# Contract addresses (deployments/base-mainnet.json)
NEXT_PUBLIC_POSITION_MANAGER=0x3f3d197d4582d1D10818a115ef7D7413FD11B8d9
NEXT_PUBLIC_LP_VAULT=0x38669C1C8fb153Ba4cCB40BF08986014EfBa0F26
NEXT_PUBLIC_ORACLE=0xAEB1d29301aaFCB8cA719e8c1B09C4cD1F6a9CE9
NEXT_PUBLIC_INSURANCE=0x96621c13dc4b6c3588Ad3bFff1B37cc1328b69ff

# Optional overrides. Defaults: https://mainnet.base.org, https://basescan.org, Base V4Quoter, WETH, cbBTC.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_V4_QUOTER=
NEXT_PUBLIC_WETH=
NEXT_PUBLIC_CBBTC=

# Optional: WalletConnect project id (injected wallets work without it) and canonical site URL.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=

# Waitlist: Postgres connection string, and a bearer token for the CSV export.
DATABASE_URL=
WAITLIST_ADMIN_TOKEN=

# Arkiv: write access for scripts/publish-arkiv.ts only.
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=

# Keeper bot (npm run keeper): its wallet key and loop interval.
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=5000
